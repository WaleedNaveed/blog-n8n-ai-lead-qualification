          "value": "qwen2.5:1.5b",
          "mode": "list",
          "cachedResultName": "qwen2.5:1.5b"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a sales assistant.\n\nThe lead has already been classified using fixed business rules.\nDo NOT change, question, or recalculate the classification.\n\nLead:\nName: {{ $json.fullName }}\nCompany: {{ $json.company }}\nProject Requirements: {{ $json.projectRequirements }}\nBudget: {{ $json.budget }}\nTimeline: {{ $json.timeline }}\nClassification: {{ $json.classification }}\n\nWrite ONE short professional sentence explaining the lead's classification.\n\nUse the project requirement as context, but remember that the classification is based on the budget:\n- COLD = budget below $4,000\n- WARM = budget from $4,000 to $9,999\n- HOT = budget $10,000 or higher\n\nReturn only the reason sentence.\nDo not include \"Reason:\".\nDo not change the classification.\nDo not include analysis or any other text."
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        16,
        -16
      ],
      "id": "54d86de5-bbbc-4688-86e4-07fdab065377",
      "name": "Generate AI Reason"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "de2d3131-a450-4445-b866-b3221a0661bd",
              "name": "classification",
              "value": "={{ $('Classify Lead').item.json.classification }}",
              "type": "string"
            },
            {
              "id": "d7b307c0-abbe-42b6-b774-bd5deb9508ab",
              "name": "reason",
              "value": "={{ $json.content.trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
