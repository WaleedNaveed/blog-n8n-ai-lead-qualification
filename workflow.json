        -16
      ],
      "id": "fc7b5fb0-0604-4ba6-bad2-2527b78174eb",
      "name": "Prepare Qualified Lead"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const budgetText = String($json.budget ?? '');\n\n// Extract all numeric amounts from values such as:\n// \"$10,000 - $15,000\"\n// \"$5,000\"\n// \"10000\"\nconst amounts = budgetText\n  .match(/\\$?\\s*\\d[\\d,]*(?:\\.\\d+)?/g)\n  ?.map(value =>\n    Number(value.replace(/[$,\\s]/g, ''))\n  )\n  .filter(Number.isFinite) ?? [];\n\nif (amounts.length === 0) {\n  throw new Error(`Unable to parse budget: \"${budgetText}\"`);\n}\n\n// For a budget range, use the lower bound.\nconst budgetAmount = Math.min(...amounts);\n\nlet classification;\n\nif (budgetAmount >= 10000) {\n  classification = 'HOT';\n} else if (budgetAmount >= 4000) {\n  classification = 'WARM';\n} else {\n  classification = 'COLD';\n}\n\nreturn {\n  json: {\n    ...$json,\n    budgetAmount,\n    classification\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
